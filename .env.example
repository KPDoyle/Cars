# CarWise production integrations
# Never commit real secrets. Configure them in Vercel Project Settings > Environment Variables.

# MarketCheck UK live used inventory
MARKETCHECK_API_KEY=

# CAP HPI licensed UK vehicle data / valuations
CAP_HPI_CLIENT_ID=
CAP_HPI_CLIENT_SECRET=
CAP_HPI_API_URL=https://api.cap-hpi.co.uk

# Auto Trader Connect
# Production capability access must also be approved by Auto Trader.
AUTOTRADER_API_KEY=
AUTOTRADER_API_SECRET=
AUTOTRADER_ADVERTISER_ID=
AUTOTRADER_API_URL=https://api.autotrader.co.uk
AUTOTRADER_SEARCH_PATH=/search

# GOV.UK Fuel Finder near-real-time local forecourt API.
# The app already uses DESNZ weekly national fuel data without credentials.
FUEL_FINDER_CLIENT_ID=
FUEL_FINDER_CLIENT_SECRET=
FUEL_FINDER_TOKEN_URL=
FUEL_FINDER_API_URL=

# Optional DVSA manufacturer-grade recalls API.
# Public model-year DVSA/GOV.UK recall checking is already live without credentials.
DVSA_RECALLS_CLIENT_ID=
DVSA_RECALLS_CLIENT_SECRET=
DVSA_RECALLS_API_KEY=

# Optional Vercel cron protection.
CRON_SECRET=
